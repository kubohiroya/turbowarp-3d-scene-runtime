{
  "name": "@kubohiroya/turbowarp-3d-scene-runtime",
  "version": "0.4.0",
  "description": "A TurboWarp extension that applies a 3D/AR scene description by dispatching its call plan to turbowarp-aframe and turbowarp-ar.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-3d-scene-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-3d-scene-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-3d-scene-runtime/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "3d",
    "ar",
    "aframe",
    "scene-graph",
    "yaml"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "templates/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "lib-editor/",
    "lib-module/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && npm run build:editor && pnpm run build:module",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.ts vite.module.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run check:module && pnpm run repo:check && pnpm run check:production-deps && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "build:editor": "tsc -p tsconfig.editor.json",
    "prepare": "npm run build",
    "check:production-deps": "node scripts/check-production-dependencies.mjs",
    "build:module": "tsc -p tsconfig.module.json && vite build --config vite.module.config.ts",
    "check:module": "node scripts/check-bundle-module.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.3.2",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.8.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "react-dom": "18.3.1",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.3.4"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-scene-graph": "^0.3.0",
    "yaml": "^2.9.1"
  },
  "exports": {
    "./*": "./*",
    "./editor-schema": {
      "types": "./lib-editor/src/editor-schema.d.ts",
      "import": "./lib-editor/src/editor-schema.js"
    },
    "./editor-metadata": {
      "types": "./lib-editor/src/editor-metadata.d.ts",
      "import": "./lib-editor/src/editor-metadata.js"
    },
    "./bundle-module": {
      "types": "./lib-module/src/bundle-module.d.ts",
      "import": "./lib-module/src/bundle-module.js"
    }
  },
  "gitHead": "d1282e44efa47128e1421498e68033729ff02f90",
  "x-turbowarp-source": {
    "revision": "d1282e44efa47128e1421498e68033729ff02f90",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
